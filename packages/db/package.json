{
  "name": "@alihdrndm/blockpace-db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/cli.ts migrate",
    "db:seed": "tsx --env-file-if-exists=../../.env src/cli.ts seed",
    "db:reset": "tsx --env-file-if-exists=../../.env src/cli.ts reset"
  },
  "dependencies": {
    "@alihdrndm/blockpace-core": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  },
  "author": "Ali Haider Nadeem",
  "license": "MIT"
}
