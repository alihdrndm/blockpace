{
  "name": "@alihdrndm/blockpace-core",
  "version": "0.1.0",
  "description": "Hotel room block attrition calculator: cumulative and per-night attrition damages, resell credit, tax, pickup forecast and risk level, in exact integer money.",
  "keywords": [
    "attrition",
    "attrition-calculator",
    "hotel",
    "room-block",
    "group-booking",
    "event-planning",
    "meeting-planning",
    "hospitality",
    "pickup",
    "forecast",
    "bigint",
    "zod"
  ],
  "homepage": "https://alihdrndm.github.io/blockpace/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alihdrndm/blockpace.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/alihdrndm/blockpace/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "author": "Ali Haider Nadeem",
  "license": "MIT",
  "devDependencies": {
    "fast-check": "^4.10.2"
  }
}
