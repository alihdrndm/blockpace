# PostgreSQL connection string (local development database from compose.yaml)
DATABASE_URL=postgres://blockpace:blockpace@localhost:5442/blockpace
# Value required in the x-api-key header on /v1 endpoints; leave empty to disable authentication (development only)
API_KEY=
# Port the API listens on
PORT=4020
# Apply database migrations automatically when the API starts (true or false)
RUN_MIGRATIONS=false
# Pin the clock's "today" to a fixed calendar date (YYYY-MM-DD); leave empty to use the real UTC date
FIXED_TODAY=
# Allow webhook targets on private addresses so the local sink works (keep false in production)
ALLOW_PRIVATE_WEBHOOK_TARGETS=true
# How often the worker polls for pending webhook deliveries, in milliseconds
WEBHOOK_POLL_MS=10000
# Timeout for each webhook delivery request, in milliseconds
WEBHOOK_TIMEOUT_MS=5000
# Base URL the web app uses to reach the API
API_BASE_URL=http://localhost:4020
