{
  "name": "api",
  "version": "0.0.1",
  "description": "blockpace HTTP API",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start --env-file ../../.env",
    "start:prod": "node dist/main",
    "test": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "dev": "nest start --watch --env-file ../../.env",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@alihdrndm/blockpace-core": "workspace:*",
    "@alihdrndm/blockpace-db": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "author": "Ali Haider Nadeem"
}
